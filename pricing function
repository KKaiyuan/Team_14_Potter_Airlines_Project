flights_df["days_until_departure"] = (departure_date - now) / pd.Timedelta(days=1)

def calculate_fare(base_fare, days_until_departure, seats_remaining, capacity):

    if base_fare <= 0:
        raise ValueError("base_fare must be greater than 0")
    if capacity <= 0:
        raise ValueError("capacity must be greater than 0")
    if 0 < seats_remaining > capacity:
        raise ValueError("seats_remaining must be between 0 and capacity")
    if days_until_departure < 0:
        return float ("nan")

# Time factor
    if days_until_departure < 4 / 24:
        time_factor = 0.85
    elif days_until_departure <= 1:
        time_factor = 1.00
    elif days_until_departure <= 7:
        time_factor = 1.35
    elif days_until_departure <= 21:
        time_factor = 1.10
    else:
        time_factor = 1.00

    load_factor = 1 - seats_remaining / capacity
    capacity_factor = 1 + 0.45 * load_factor
    demand_factor = 0.9 + 0.3 * route_popularity

    final_fare = base_fare * time_factor * capacity_factor * demand_factor
    return round(min(max(final_fare, 200), 1500),2)

